<!-- The watch's own editor: hold MENU (or long-press the face) > Watch Face > Customize.
     Style = colour theme (BuffGen / THEMES in tools/build_assets.py, ids 1..6).
     Data 1 = what the left arc tracks, Data 2 = the right arc (the buddy follows it). Garmin's editor only offers its
     own complication types; source/Metrics.mc says how Buff reads each one (Calories = active calories, Heart rate =
     resting heart rate). -->
<resources>
    <watchface-config>
        <styles>
            <style id="1" label="@Strings.ThemeWhite"/>
            <style id="2" label="@Strings.ThemeCream" default="true"/>
            <style id="3" label="@Strings.ThemeIce"/>
            <style id="4" label="@Strings.ThemeEmber"/>
            <style id="5" label="@Strings.ThemeCoral"/>
            <style id="6" label="@Strings.ThemeMint"/>
        </styles>
        <data>
            <complication id="1">
                <type default="true">Complications.COMPLICATION_TYPE_STEPS</type>
                <type>Complications.COMPLICATION_TYPE_CALORIES</type>
                <type>Complications.COMPLICATION_TYPE_INTENSITY_MINUTES</type>
                <type>Complications.COMPLICATION_TYPE_FLOORS_CLIMBED</type>
                <type>Complications.COMPLICATION_TYPE_BODY_BATTERY</type>
                <type>Complications.COMPLICATION_TYPE_STRESS</type>
                <type>Complications.COMPLICATION_TYPE_SLEEP_SCORE</type>
                <type>Complications.COMPLICATION_TYPE_HEART_RATE</type>
                <type>Complications.COMPLICATION_TYPE_RECOVERY_TIME</type>
                <type>Complications.COMPLICATION_TYPE_PULSE_OX</type>
                <type>Complications.COMPLICATION_TYPE_BATTERY</type>
            </complication>
            <complication id="2">
                <type>Complications.COMPLICATION_TYPE_STEPS</type>
                <type default="true">Complications.COMPLICATION_TYPE_CALORIES</type>
                <type>Complications.COMPLICATION_TYPE_INTENSITY_MINUTES</type>
                <type>Complications.COMPLICATION_TYPE_FLOORS_CLIMBED</type>
                <type>Complications.COMPLICATION_TYPE_BODY_BATTERY</type>
                <type>Complications.COMPLICATION_TYPE_STRESS</type>
                <type>Complications.COMPLICATION_TYPE_SLEEP_SCORE</type>
                <type>Complications.COMPLICATION_TYPE_HEART_RATE</type>
                <type>Complications.COMPLICATION_TYPE_RECOVERY_TIME</type>
                <type>Complications.COMPLICATION_TYPE_PULSE_OX</type>
                <type>Complications.COMPLICATION_TYPE_BATTERY</type>
            </complication>
        </data>
    </watchface-config>
</resources>
